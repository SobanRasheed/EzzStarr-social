# API Configuration
# NOTE: VITE_API_URL should NOT include '/api' as the path is added in fetch calls
VITE_API_URL=http://localhost:5001

# Zylalab API Key (for Anime/Manga/Novel Discovery API)
# Get your key from: https://zylalabs.com/api/1760/anime+manga+and+novel+discove
ry+api
VITE_ZYLA_API_KEY=your_zylalab_api_key_here

# Note: Jikan, 4chan, and Open Library APIs are free and don't require API keys
